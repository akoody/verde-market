# MongoDB Atlas or another replica set. Transactions do not work on standalone MongoDB.
MONGODB_URI=mongodb+srv://user:password@cluster.example/verde-market?retryWrites=true&w=majority

# Canonical HTTPS origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=https://verdemarket.shop
# Runtime origin for same-origin request checks (defaults to NEXT_PUBLIC_APP_URL).
APP_URL=https://verdemarket.shop

# Signs login sessions. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-32-random-characters

# Account that owns the initial catalog during bootstrap.
SEED_OWNER_PHONE=+37369000000
SEED_OWNER_USERNAME=verde_admin
SEED_OWNER_PASSWORD=replace-with-a-strong-unique-password

# Persistent directory inside the production container.
UPLOAD_DIR=/app/uploads
